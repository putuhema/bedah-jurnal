# Supabase project (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SECRET_KEY=

# Optional: require this code to create a new room on the landing page.
ROOM_CREATE_CODE=

# Optional: "Tanya AI". Leave empty to hide the AI buttons.
#   LLM_PROVIDER  openai-compatible | anthropic   (or a provider name: openrouter, groq,
#                 deepseek, openai, ollama, … → all treated as openai-compatible)
#   LLM_BASE_URL  OpenRouter  https://openrouter.ai/api/v1
#                 Groq        https://api.groq.com/openai/v1
#                 DeepSeek    https://api.deepseek.com/v1
#                 OpenAI      https://api.openai.com/v1
#                 Ollama      http://localhost:11434/v1   (no key needed)
#                 (anthropic: leave empty)
#   LLM_API_KEY   the provider's key
#   LLM_MODEL     the provider's model name (anthropic default: claude-opus-5-5)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Questions per room per 24 hours (default 40)
AI_DAILY_LIMIT=
# Max answer length in tokens for openai-compatible providers (default 1200)
AI_MAX_TOKENS=

# Optional: your email for OpenAlex's "polite pool" (faster, more reliable paper search)
OPENALEX_EMAIL=
# Tests only: lets "Tempel link" fetch from localhost fixtures. Never set in production.
ALLOW_PRIVATE_URLS=
